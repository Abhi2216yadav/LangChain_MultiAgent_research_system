# Copy this file to .env and add your own keys.
# Never commit .env - it is ignored by git.

# Required: Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model. gemini-3.5-flash is fast and supports tool calling.
GEMINI_MODEL=gemini-3.5-flash

# Required: Tavily web search API key (https://app.tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Workflow: number of writing passes. 1 = draft + review, 2+ = allow revisions.
MAX_REVISIONS=1

# Optional: choose the LLM provider. "google" (default) or "openai".
LLM_PROVIDER=google

# Optional: only needed when LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
